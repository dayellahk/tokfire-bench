DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE
BETTER_AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
BETTER_AUTH_URL=https://tokfires.com
# Optional Google web sign-in. Both values are required; never use NEXT_PUBLIC_.
# Redirect URI: https://tokfires.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for web sign-in and account security. Secret is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=tokfires.com
