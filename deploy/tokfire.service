[Unit]
Description=TokFire Bench web application
After=network.target mysql.service

[Service]
Type=simple
User=tokfire
Group=tokfire
WorkingDirectory=/opt/tokfire/current
EnvironmentFile=/etc/tokfire.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tokfire/current/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
