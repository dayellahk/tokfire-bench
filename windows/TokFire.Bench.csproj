<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TokFire Bench</AssemblyName>
    <Version>0.8.0</Version>
    <Company>TokFire Labs</Company>
    <Product>TokFire Bench</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
  <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <Content Include="README.md" CopyToOutputDirectory="PreserveNewest"/>
  <Content Include="../native/Sources/LocalAIBench/Resources/*.py" Link="runner/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../native/Sources/LocalAIBench/Resources/languages.json" Link="languages.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../native/Sources/LocalAIBench/Resources/lemon-squeezy.json" Link="runner/lemon-squeezy.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
<Target Name="RemoveUnusedWpfReference" BeforeTargets="ResolveAssemblyReferences"><ItemGroup><Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Reference.Identity)').EndsWith('Microsoft.Web.WebView2.Wpf.dll'))" /></ItemGroup></Target>
</Project>
