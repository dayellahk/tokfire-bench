# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/native/.build/
/native/.build-release/
/native/.swiftpm/
__pycache__/
*.pyc
*.tsbuildinfo
/native/build/

/windows/bin/
/windows/obj/
/windows/publish/

/windows/tests/bin/
/windows/tests/obj/

/android/build/
/android/assets/
*.keystore
*.jks

# Internal reference datasets and hosting metadata stay private.
/data/
/research/
/.openai/
/deploy/seed.mjs
/scripts/import-omlx.py
